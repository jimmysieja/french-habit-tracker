# Copy to `.env` and fill in. `.env` is git-ignored.

# Path to your Google service-account JSON key file.
FR_SERVICE_ACCOUNT=./service-account.json

# The spreadsheet id — the long string in the sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
FR_SHEET_KEY=your-google-sheet-id-here

# Optional — only if your tab names differ from the defaults.
# FR_DAILY_TAB=📅Daily Log
# FR_OBJECTIVES_TAB=🎯 Weekly Objectives
# FR_ANALYTICS_TAB=📈 Analytics
